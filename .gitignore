# Build output
bin/
obj/
.vs/
artifacts/
publish/

# Local release folders
Build/XboxMetroLauncher/
Build/**/*.exe
Build/**/*.dll
Build/**/*.pdb

# Logs and diagnostics
*.log
logs/
Logs/
discord-social-debug.log

# User and machine-local data
UserData/
*.user
*.suo
*.cache
Thumbs.db
Desktop.ini

# IDE noise
.idea/
.vscode/
*.tmp
*.bak
*.orig

# Local secrets/config overrides
appsettings.Local.json
appsettings.Development.json
*.secrets.json
steam-web-config.json

# Ad-hoc local dev/verification scripts (may contain local test credentials)
_vd_*.ps1
_vd_*.json

# Large local-only / vendored-build / superseded folders (not part of the
# curated public source tree)
Xenia Rebuild folder/
Xenia api folder/
old web/
xenia Emulator/
.vite/

# JS/TS dependency and build output
node_modules/
dist/
web-port/.dev-build/
web-port/.api-dev-build/

# Runtime databases and generated user data
*.db
*.sqlite
*.sqlite3
# Downloaded third-party tool binaries (large, not our source code)
xenia api/.tools/
xenia api/XeniaManager.Api/data/

# Assets/: Xbox 360/Xbox Live dashboard UI material (boot video, tile art,
# icons, sign-in branding, layout reference screenshots) is included, same
# as the original DashX360 project's public repo (accepted, known risk).
# Per-game Steam art (cover/header/hero/logo pulled per-App-ID from Steam's
# CDN) is still excluded: that's separate, publisher-owned artwork with a
# more clearly enforced takedown history, unrelated to the Xbox dashboard
# assets above.
Assets/GameArt/Steam/*
!Assets/GameArt/Steam/.gitkeep
