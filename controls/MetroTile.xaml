<UserControl x:Class="XboxMetroLauncher.Controls.MetroTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:XboxMetroLauncher.Controls" x:Name="Root" Focusable="False" ClipToBounds="False" Width="{Binding TileWidth, ElementName=Root}" Height="{Binding TileHeight, ElementName=Root}">
  <Button Name="TileButton" Focusable="True" ClipToBounds="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="1" BorderBrush="{StaticResource MetroTileBorderBrush}" Panel.ZIndex="0" controls:TileSelectionChrome.IsEnabled="True" Command="{Binding Command, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}" Background="{Binding TileBrush, ElementName=Root}" GotKeyboardFocus="TileButton_OnGotKeyboardFocus">
    <Control.Template>
      <ControlTemplate TargetType="{x:Type Button}">
        <Grid Name="TileRoot" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
          <UIElement.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </UIElement.RenderTransform>
          <Border Name="Outer" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2" ClipToBounds="True">
            <Grid>
              <Rectangle Fill="{StaticResource GlassPanelBrush}" />
              <Image Stretch="UniformToFill" Opacity="0.9" Source="{Binding ImagePath, ElementName=Root, Converter={StaticResource StringToImageSourceConverter}}" />
              <Rectangle VerticalAlignment="Bottom" Height="80">
                <Shape.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#B8000000" Offset="1" />
                  </LinearGradientBrush>
                </Shape.Fill>
              </Rectangle>
              <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                <TextBlock Foreground="#FFFFFFFF" FontSize="22" FontWeight="Light" TextTrimming="CharacterEllipsis" Text="{Binding Title, ElementName=Root}" />
                <TextBlock Foreground="#DDEEEEEE" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle, ElementName=Root}" Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource EmptyToVisibilityConverter}}" />
              </StackPanel>
              <Border Name="FocusChrome" BorderBrush="#FFFFFFFF" BorderThickness="2" Opacity="0" CornerRadius="2" />
              <Rectangle VerticalAlignment="Top" Height="42" Opacity="0.28">
                <Shape.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Shape.Fill>
              </Rectangle>
            </Grid>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=(controls:TileSelectionChrome.IsActive), RelativeSource={RelativeSource Self}}">
            <TriggerBase.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FocusChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13">
                    <DoubleAnimation.EasingFunction>
                      <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.EnterActions>
            <TriggerBase.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FocusChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10">
                    <DoubleAnimation.EasingFunction>
                      <SineEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12">
                    <DoubleAnimation.EasingFunction>
                      <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12">
                    <DoubleAnimation.EasingFunction>
                      <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.ExitActions>
            <Setter TargetName="TileRoot" Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="9" Direction="315" Color="#CC000000" Opacity="0.42" />
              </Setter.Value>
            </Setter>
            <Setter Property="Panel.ZIndex" Value="100" />
          </DataTrigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Outer" Property="UIElement.Opacity" Value="0.82" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Outer" Property="UIElement.Opacity" Value="0.45" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Control.Template>
  </Button>
</UserControl>