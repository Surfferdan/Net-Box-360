{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBoxDatabase": {
    "DatabasePath": "data/netbox.db",
    "SessionLifetime": "7.00:00:00"
  },
  "XeniaApi": {
    "BaseUrl": "http://localhost:5077"
  },
  "NetBoxInput": {
    "Host": "127.0.0.1",
    "Port": 47600
  },
  "CloudMorph": {
    "BaseUrl": "http://127.0.0.1:8080",
    "StreamBaseUrl": "http://127.0.0.1:8080/embed",
    "EnableDedicatedWorkers": false,
    "AllowWorkerReuseWhenExhausted": true,
    "DedicatedWorkerUrls": [
      "http://127.0.0.1:8080"
    ],
    "RequestTimeoutSeconds": 4,
    "StartStreamRetryCount": 1,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerOpenSeconds": 15
  },
  "AudioRouting": {
    "MuteHostGamePlayback": false,
    "RouteToVirtualSink": false,
    "SwitchDefaultOutputToVirtualSink": true,
    "RestoreDefaultOutputOnStop": true,
    "RequireVirtualSink": false,
    "VirtualSinkNameContains": "",
    "CaptureInputDevice": "",
    "SessionDetectAttempts": 20,
    "SessionDetectDelayMs": 250
  },
  "VirtualDisplay": {
    "Enabled": true,
    "RequireService": true,
    "UseSyntheticFallback": false,
    "CommandTimeoutSeconds": 120,
    "CommandWorkingDirectory": "..",
    "ProvisionCommand": "dotnet",
    "ProvisionArguments": "run --project \"NetBox.VirtualDisplayCli/NetBox.VirtualDisplayCli.csproj\" -- provision --session \"{sessionId}\" --title \"{gameTitle}\"",
    "ReleaseCommand": "dotnet",
    "ReleaseArguments": "run --project \"NetBox.VirtualDisplayCli/NetBox.VirtualDisplayCli.csproj\" -- release --session \"{sessionId}\" --display \"{displayId}\"",
    "StatusCommand": "dotnet",
    "StatusArguments": "run --project \"NetBox.VirtualDisplayCli/NetBox.VirtualDisplayCli.csproj\" -- status --display \"{displayId}\"",
    "CleanupCommand": "dotnet",
    "CleanupArguments": "run --project \"NetBox.VirtualDisplayCli/NetBox.VirtualDisplayCli.csproj\" -- cleanup"
  },
  "XeniaData": {
    "ProfilesFilePath": "data/profiles.json",
    "AchievementsDirectory": "data/achievements",
    "SavesDirectory": "data/saves",
    "ConfigFilePath": "data/config.json",
    "GamesDirectory": "data/games",
    "XeniaExecutablePath": "C:\\Users\\Owner\\Desktop\\dashx360-1.2.2\\xenia Emulator\\Emulators\\Xenia NetBox\\xenia_netbox.exe"
  }
}
