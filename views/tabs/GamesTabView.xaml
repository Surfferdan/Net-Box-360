<UserControl x:Class="XboxMetroLauncher.Views.Tabs.GamesTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:XboxMetroLauncher.Views.Tabs;assembly=DashX360">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Canvas.Left="-40" Canvas.Top="76" Opacity="0.48" Visibility="Collapsed">
        <Button Width="155" Height="148" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="#FFFFFFFF">
            <TextBlock Text="XBOX" Foreground="#FF528E38" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
      <Button Canvas.Left="258" Canvas.Top="74" Width="155" Height="153" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.OpenMyGamesCommand}" CommandParameter="games.mygames">
        <Grid Background="{Binding Shell.DashboardTileBrush}">
          <Image Width="72" Height="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0" Source="{Binding Source=Assets/Tiles/Marketplace/mygames.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="22" Margin="15,0,0,12" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=games.mygames|My Games}" />
        </Grid>
      </Button>
      <Button Canvas.Left="258" Canvas.Top="229" Width="155" Height="149" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="games.marketplace">
        <Grid Background="{Binding Shell.DashboardTileBrush}">
          <Image Width="58" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Source="{Binding Source=Assets/Tiles/Marketplace/game_marketplace.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="22" Margin="15,0,0,12" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=games.marketplace|Game Marketplace}" />
        </Grid>
      </Button>
      <Button Canvas.Left="415" Canvas.Top="74" Width="400" Height="303" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="games.forza">
        <Grid ClipToBounds="True">
          <Panel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFE9F0EA" Offset="0" />
              <GradientStop Color="#FF7E968C" Offset="0.32" />
              <GradientStop Color="#FF17201C" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=games.forza|Assets/Tiles/forzahorizongames.jpg|512}" />
          <Rectangle Fill="#44000000" />
          <Rectangle Height="78" VerticalAlignment="Bottom" Fill="#8F000000" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="24" Margin="10,0,0,42" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=games.forza|Forza Horizon}" />
          <TextBlock Foreground="#DFFFFFFF" FontSize="24" Margin="10,0,0,12" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileSecondaryTitleConverter}, ConverterParameter=games.forza|December IGN Pack}" />
        </Grid>
      </Button>
      <Button Canvas.Left="817" Canvas.Top="74" Width="200" Height="151" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="games.minecraft">
        <Grid ClipToBounds="True">
          <Panel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF0F2719" Offset="0" />
              <GradientStop Color="#FF6A8D36" Offset="0.6" />
              <GradientStop Color="#FF131814" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=games.minecraft|Assets/Tiles/minecraftgames.jpg|320}" />
          <Rectangle Fill="#33000000" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,14" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=games.minecraft|Minecraft}" />
        </Grid>
      </Button>
      <Button Canvas.Left="817" Canvas.Top="227" Width="200" Height="150" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="games.blackops">
        <Grid ClipToBounds="True">
          <Panel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF1B1B1F" Offset="0" />
              <GradientStop Color="#FF376B7B" Offset="0.52" />
              <GradientStop Color="#FF111111" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=games.blackops|Assets/Tiles/blackops2games.jpg|320}" />
          <Rectangle Fill="#33000000" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,14" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=games.blackops|Black Ops II}" />
        </Grid>
      </Button>
      <TextBlock Canvas.Left="820" Canvas.Top="387" Text="ADVERTISEMENT" Foreground="#FFBFC4C2" FontSize="13" />
      <StackPanel Canvas.Left="1200" Canvas.Top="74" Opacity="0.66" Visibility="Collapsed">
        <Button Width="155" Height="151" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="My Apps" Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
        <Button Width="155" Height="151" Margin="0,2,0,0" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Apps&#xA;Marketplace" Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
      </StackPanel>
    </Canvas>
  </Grid>
</UserControl>
