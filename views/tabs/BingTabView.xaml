<UserControl x:Class="XboxMetroLauncher.Views.Tabs.BingTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:XboxMetroLauncher.Views.Tabs;assembly=DashX360">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas Name="HomeAlignedFrame" Left="198" Top="11" Width="764" Height="368" ClipToBounds="False">
        <Canvas Name="ContentTileLayer" Left="0" Top="0" Width="764" Height="368">
          <TextBlock Text="Search Xbox for games, movies, music and apps" Canvas.Left="180" Canvas.Top="93" Foreground="#BFFFFFFF" FontSize="19" FontWeight="Light" />
          <TextBlock Text="bing" Canvas.Left="0" Canvas.Top="137" Foreground="#F2FFFFFF" FontSize="44" FontWeight="Light" />
          <Border Name="SearchBoxFrame" Canvas.Left="179" Canvas.Top="123" Width="585" Height="92" BorderBrush="#C9FFFFFF" BorderThickness="2" Background="#C8000000" MouseLeftButtonDown="SearchBoxFrame_OnMouseLeftButtonDown">
            <Grid>
              <TextBox Name="BingSearchBox" Background="#00FFFFFF" BorderThickness="0" Foreground="#F2FFFFFF" CaretBrush="#FFFFFFFF" FontSize="40" FontWeight="Light" Padding="28,18,84,0" Text="{Binding Shell.SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="BingSearchBox_OnKeyDown" />
              <Path Stroke="#F2FFFFFF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0" Width="50" Height="50" Data="M17,17 A14,14 0 1 1 36,36M34,34 L47,47" />
            </Grid>
          </Border>
          <Button Canvas.Left="681" Canvas.Top="123" Width="83" Height="92" Opacity="0" Command="{Binding SubmitSearchCommand}" />
        </Canvas>
      </Canvas>
    </Canvas>
  </Grid>
</UserControl>
