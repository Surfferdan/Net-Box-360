<UserControl x:Class="XboxMetroLauncher.Views.Tabs.MediaTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:XboxMetroLauncher.Views.Tabs;assembly=DashX360">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Button Canvas.Left="236" Canvas.Top="76" Width="146" Height="148" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.apps">
        <Grid ClipToBounds="True" Background="{Binding Shell.DashboardTileBrush}">
          <Image Width="144" Height="102" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Source="{Binding Source=Assets/Tiles/Marketplace/my_video_apps_custom.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=192}" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="22" Margin="12,0,0,12" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=video.apps|My Video Apps}" />
        </Grid>
      </Button>
      <Button Canvas.Left="236" Canvas.Top="226" Width="146" Height="148" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.marketplace">
        <Grid Background="{Binding Shell.DashboardTileBrush}">
          <Image Width="58" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0" Source="{Binding Source=Assets/Tiles/Marketplace/video_marketplace.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="22" Margin="12,0,0,12" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=video.marketplace|Video Marketplace}" />
        </Grid>
      </Button>
      <Button Canvas.Left="384" Canvas.Top="73" Width="308" Height="301" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.feature">
        <Grid ClipToBounds="True">
          <Panel.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFF2F0E8" Offset="0" />
              <GradientStop Color="#FFB59F80" Offset="0.5" />
              <GradientStop Color="#FF201712" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=video.feature|Assets/Tiles/thedarkkightvideo.jpg|512}" />
          <Rectangle>
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#18000000" Offset="0.54" />
                <GradientStop Color="#A8000000" Offset="1" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="46" VerticalAlignment="Bottom" Fill="#82000000" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="19" Margin="12,0,0,12" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=video.feature|The Dark Knight}" />
        </Grid>
      </Button>
      <Button Canvas.Left="694" Canvas.Top="73" Width="148" Height="150" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.cloudy">
        <Grid Background="#FF33434A" ClipToBounds="True">
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=video.cloudy|Assets/Tiles/cloudywithachanceofmeatballsvideo.jpg|256}" />
          <Rectangle Fill="#55000000" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="16" Margin="10,0,8,12" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=video.cloudy|Cloudy with a Chance of Meatballs}" />
        </Grid>
      </Button>
      <Button Canvas.Left="844" Canvas.Top="73" Width="198" Height="150" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.recent">
        <Grid Background="#FFFFFFFF">
          <Path Fill="#FF59B631" Data="M0,115 C70,28 132,82 198,4 L198,150 L0,150" />
          <TextBlock Text="Recent" Foreground="#FF2B2B2B" FontSize="30" Margin="20,48,0,0" />
        </Grid>
      </Button>
      <Button Canvas.Left="694" Canvas.Top="225" Width="148" Height="149" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.kungfu">
        <Grid Background="#FFE9C330" ClipToBounds="True">
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=video.kungfu|Assets/Tiles/kungfupanda2video.jpg|256}" />
          <Rectangle Fill="#44000000" />
          <TextBlock Text="HD" Foreground="#AAFFFFFF" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="21" Margin="10,0,0,12" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=video.kungfu|Kung Fu Panda 2}" />
        </Grid>
      </Button>
      <Button Canvas.Left="844" Canvas.Top="225" Width="198" Height="149" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchDashboardTileCommand}" CommandParameter="video.hbogo">
        <Grid ClipToBounds="True">
          <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=video.hbogo|Assets/Tiles/hbogovideo.jpg|320}" />
          <TextBlock Text="ADVERTISEMENT" Foreground="#FFBFC4C2" FontSize="13" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,-22" />
        </Grid>
      </Button>
      <StackPanel Canvas.Left="1200" Canvas.Top="76" Opacity="0.66" Visibility="Collapsed">
        <Button Width="150" Height="148" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="My Games" Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
        <Button Width="150" Height="148" Margin="0,2,0,0" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Game&#xA;Marketplace" Foreground="#FFFFFFFF" FontSize="20" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
      </StackPanel>
    </Canvas>
  </Grid>
</UserControl>
